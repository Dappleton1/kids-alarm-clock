# Copy to secrets.yaml (next to these files in the ESPHome dashboard) and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
ota_password: "pick-a-password"          # protects over-the-air updates
ap_fallback_password: "pick-a-password"  # the clock's own hotspot if it can't find your WiFi
# One API key per clock. Generate: ESPHome dashboard -> Secrets, or `openssl rand -base64 32`.
api_key_clock_1: "base64-32-bytes"
api_key_clock_2: "base64-32-bytes"
